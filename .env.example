# Decision engine: rule-based (offline) | anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=rule-based
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Embeddings: hashing (offline, deterministic) | openai
EMBEDDINGS_PROVIDER=hashing
EMBEDDINGS_DIM=384
# Leave empty to use the in-memory vector store
DATABASE_URL=postgresql://triage:triage@db:5432/triage
# Shared secret expected in the X-API-Key header of webhooks
API_KEY=change-me
# Personal approval tokens: name:token pairs (12+ chars). Approvals are disabled when empty.
APPROVER_TOKENS=analyst:change-me-approver-token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MIN_CONFIDENCE=0.55
